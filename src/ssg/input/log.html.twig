{% extends '_templates/base.html.twig' %}

{% block content %}
    <div class="timeline u-stack u-stack__1.5">
        {% for entry in data.log %}
            <div class="timeline__entry u-stack u-stack__1.5">
                <h2 class="timeline__entry__title" id="{{ entry.publishedAt | date('U') }}">{{ entry.publishedAt | date('F j, Y') }}</h2>
                {{ entry.content | markdown }}
            </div>
        {% endfor %}
    </div>
{% endblock %}
